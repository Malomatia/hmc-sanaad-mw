# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=443
API_PREFIX=api/v1
# Comma-separated list of allowed CORS origins (use * for all in dev)
CORS_ORIGINS=*

# ── Sanaad gateway (reference; used by Cerner/legacy calls) ──
SANAAD_GATEWAY_BASE_URL=https://apigwuat.api.hamad.qa/sanaad

# ── Oracle (node-oracledb thick mode) ───────────────────────
# Docker/jumpstation: these are injected from the server environment (managed by
# DevOps) via docker-compose `environment:` and take precedence over this file.
# The values below are for LOCAL development only.
ORACLE_USER=xxhmc_snd
ORACLE_PASSWORD=change_me
# Easy Connect string: host:port/service_name
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_TIMEOUT=60
ORACLE_QUEUE_TIMEOUT_MS=25000
ORACLE_CALL_TIMEOUT_MS=25000
# Set to true to skip creating the pool at boot (useful for local dev without Oracle)
ORACLE_DISABLED=false
# POST /diagnostics/oracle/sql (ad-hoc SELECT-only console over the
# XXHMC_SND_* schema; named :binds; ROWNUM-capped).
# ⚠ TEMPORARY: currently NOT gated at all (client request 2026-08-31) — this
# flag and the NODE_ENV=production check are ignored until the gates are
# restored in diagnostics.controller.ts. Only DIAGNOSTICS_ENABLED still hides
# the whole /diagnostics group.
# Companions: GET /diagnostics/oracle-views (all XXHMC_SND_* objects) and
# GET /diagnostics/oracle-object?name= (columns/parameters of one object).
ORACLE_SQL_ENABLED=true
# Thick mode (true) loads the Oracle Client libraries; false uses the built-in thin driver.
ORACLE_THICK_MODE=true
# Path to the Oracle Client / Instant Client libraries. Leave empty to use the
# system library path (PATH on Windows, LD_LIBRARY_PATH/ldconfig on Linux).
ORACLE_CLIENT_LIB_DIR=

# ── Users/Sanaad SQL Server DB (auth cycle + API-1 healthcheck tables) ──
# Backs HMC_Sanad_DeviceRegn_tbl (device binding + MPIN), HMC_RHAP_OTP_tbl
# (OTP rows) and the HMC_Sanad_AppDownTime/App_Update tables for /healthcheck.
USERS_DB_HOST=
USERS_DB_PORT=1433
USERS_DB_NAME=
USERS_DB_USER=
USERS_DB_PASSWORD=
USERS_DB_POOL_MIN=2
USERS_DB_POOL_MAX=10
USERS_DB_REQUEST_TIMEOUT_MS=25000
USERS_DB_CONNECT_TIMEOUT_MS=15000
# TLS to SQL Server; set USERS_DB_TRUST_SERVER_CERT=true for self-signed instances.
USERS_DB_ENCRYPT=true
USERS_DB_TRUST_SERVER_CERT=false
# IGNORED since 2026-08-31: the Users DB pool is always created directly
# (eager at boot, lazily retried on first use; boot never crashes on failure).
# Leave USERS_DB_HOST empty for local dev without SQL Server — auth-cycle
# calls then answer 503 naming the missing vars.
USERS_DB_DISABLED=false
# Enables POST /diagnostics/users-db/sql (ad-hoc SELECT-only console).
# Ignored in production — the endpoint always returns 403 there.
USERS_DB_SQL_ENABLED=false

# ── MOTC SMS gateway DB (OTP delivery + employee view) ──────
# OTP_STORE=legacy (default since 2026-09-03): OTPs are stored/validated in
# HMC_RHAP_OTP_tbl on the Users DB, and the SMS goes out via OTP_DELIVERY.
# OTP_STORE=motc: MOTC_SMS_PushTable doubles as store AND delivery (the old
# 2026-08-25 arrangement).
OTP_STORE=legacy
# Delivery for the legacy store: motc (default) INSERTs the SMS into
# MOTC_SMS_PushTable; http uses the generic SMS_API_* adapter below.
OTP_DELIVERY=motc
# TESTING: non-empty pins every generated OTP to this value so the journey can
# be tested without reading the SMS. LEAVE EMPTY IN PRODUCTION (random OTPs).
OTP_STATIC_VALUE=123456
# OTP alphabet: numeric (default, OTP_LENGTH digits) or alphanumeric
# (OTP_LENGTH characters from A-Z/2-9, ambiguous I/O/0/1 excluded).
OTP_CHARSET=numeric
OTP_IN_RESPONSE=false
# Named instance + static port per the client: HSHCL7VVSQ1\SQL1, port 9001.
# With a port set, the instance name part of the host is informational only;
# set MOTC_SMS_DB_PORT=0 to resolve via the SQL Browser/instance name instead.
MOTC_SMS_DB_HOST=HSHCL7VVSQ1\SQL1
MOTC_SMS_DB_PORT=9001
MOTC_SMS_DB_NAME=MOTC_SMS
MOTC_SMS_DB_USER=Sanaad_Liv_Usr
MOTC_SMS_DB_PASSWORD=
MOTC_SMS_DB_POOL_MIN=2
MOTC_SMS_DB_POOL_MAX=10
MOTC_SMS_DB_REQUEST_TIMEOUT_MS=25000
MOTC_SMS_DB_CONNECT_TIMEOUT_MS=15000
MOTC_SMS_DB_ENCRYPT=true
MOTC_SMS_DB_TRUST_SERVER_CERT=false
# Set to true to skip creating the pool at boot (local dev without the gateway DB)
MOTC_SMS_DB_DISABLED=false
# POST /diagnostics/motc-sms-db/sql (ad-hoc SELECT-only console).
# ⚠ TEMPORARY: currently NOT gated at all (client request 2026-09-03) — this
# flag and the NODE_ENV=production check are ignored until the gates are
# restored in diagnostics.controller.ts (same treatment as ORACLE_SQL_ENABLED).
# Push-table rows contain live OTPs, so restore the gates before hardening.
# Connectivity test: GET /health/motc-sms-db (mirrors /health/db + /health/users-db).
MOTC_SMS_SQL_ENABLED=true
# Fixed columns of the documented INSERT. MOTC_SMS_APP_ID (<AppId>) feeds
# ServiceID, ApplicationID and — unless MOTC_SMS_FROM_ADDRESS overrides it —
# FromAddress; MOTC_SMS_SUBJECT_ID is <Subject>. Values pending from the client.
MOTC_SMS_TABLE=MOTC_SMS_PushTable
MOTC_SMS_APP_ID=
MOTC_SMS_FROM_ADDRESS=
MOTC_SMS_SUBJECT_ID=
MOTC_SMS_PRIORITY=1
MOTC_SMS_LANGUAGE_ID=1
MOTC_SMS_RECIPIENT_ADDRESS_TYPE=1
MOTC_SMS_PROCESSED_STATE=0
MOTC_SMS_MESSAGE_EXPIRE_MINUTES=5
MOTC_SMS_CUSTOMER_ID=
MOTC_SMS_MASK_MESSAGE_LOG=1
# LEAVE EMPTY (recommended): BusinessParam1/2 then carry username + device
# IMEI, which is what lets validation find "the latest OTP for THIS
# user+device". Pinning static values degrades verification to a
# MessageID-only lookup.
MOTC_SMS_BUSINESS_PARAM1=
MOTC_SMS_BUSINESS_PARAM2=
# ProcessedState written for EMAIL-delivered OTP rows (user has no mobile):
# the row is stored for validation like any OTP but must NOT be pushed as an
# SMS by the gateway — we deliver it over SMTP ourselves. Default 1
# (= already processed); confirm the gateway's "skip" value with the MOTC team.
MOTC_SMS_EMAIL_PROCESSED_STATE=1
# Live-employee master view on the MOTC_SMS DB. /auth/initiate (with
# AUTH_DIRECTORY=usersdb) checks the username against its UserName column and
# refuses users absent from it; EMPLOYEE_NAME/EMPLOYEE_NUMBER/MOBILE_NUMBER
# supply the identity + OTP SMS destination (see MssqlUserRepository).
MOTC_SMS_EMPLOYEE_MASTER_VIEW=HMC_SND_LIV_EMP_MASTER_VW

# ── SMS gateway (OTP delivery — legacy OTP_STORE=legacy path) ──
# Generic HTTP adapter until the corporate gateway contract is confirmed.
# Empty SMS_API_BASE_URL = log-only (masked) in non-production; a hard error in production.
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_TIMEOUT_MS=25000
# {otp} is replaced with the generated code at send time — used by BOTH OTP
# stores (it is the MessageBody of the MOTC push row too).
SMS_MESSAGE_TEMPLATE="OTP to register for Sanaad App is {otp}\n\nرمز التحقق للتسجيل في تطبيق سند هو {otp}"

# ── SMTP email (OTP fallback + diagnostics test email) ──────
# Used when the directory has NO mobile number for the user but does have an
# email address (both OTP stores), and by POST /diagnostics/email/test.
# Empty SMTP_HOST = masked log-only in non-production; a hard error in production.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (SMTPS, usually port 465); false = STARTTLS when offered.
SMTP_SECURE=false
# Leave user/password empty for an internal relay that allows anonymous submit.
SMTP_USER=
SMTP_PASSWORD=
# Set false to accept a self-signed cert on an internal relay.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=25000
# From header, e.g. "Sanaad <no-reply@hamad.qa>". Required once SMTP_HOST is set.
EMAIL_FROM=
EMAIL_OTP_SUBJECT=Sanaad verification code
# {otp} is replaced with the generated code at send time.
EMAIL_MESSAGE_TEMPLATE=OTP to register in Sanaad App is {otp}
EMAIL_MESSAGE_TEMPLATE_AR=رمز التحقق لتسجيل الدخول في تطبيق سند هو {otp}

# ── App-launch health check (API-1) ─────────────────────────
# AppName matched against HMC_Sanad_AppMaster_Tbl.AppName when the Users DB is
# enabled; the APP_* values below are the config-driven fallback.
APP_NAME=SanaadHealth

# ── Auth (JWT / bearer from gateway) ────────────────────────
# NOTE: op-1 login flow is out-of-band ("Another document provided").
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=sanaad
JWT_AUDIENCE=sanaad-b2e
JWT_EXPIRES_IN=1h
# Refresh-token lifetime (POST /auth/token/refresh issues a new pair and
# revokes the used refresh token — one-time use).
JWT_REFRESH_EXPIRES_IN=7d
# true = dev bypass everywhere: guards permissive AND the auth journey
# (validate/OTP/MPIN/login) returns synthesized identities without touching
# LDAP/Users DB. false = the REAL journey runs in every environment (needs
# USERS_DB_* and, unless AUTH_DIRECTORY=usersdb, LDAP/Entra reachable).
# No longer tied to NODE_ENV.
AUTH_DISABLED=false
# TESTING ONLY: /auth/login returns a fixed AIBRAHIM39 payload (no MPIN/

eds the FULL user data (employee fields +
# functionaccesslist) inside the signed JWT as a `userdata` claim.
# Takes precedence over AUTH_DISABLED for login. Never enable in production.
AUTH_STATIC_LOGIN=false
# Identity provider for the auth journey: ldap (default) | entra | usersdb.
# usersdb = no corporate directory: the userValidate check resolves the
# username against the live-employee master view on the MOTC_SMS DB
# (MOTC_SMS_EMPLOYEE_MASTER_VIEW; users absent from it are refused — see
# MssqlUserRepository).
AUTH_DIRECTORY=usersdb
# Users-DB view/table behind the login functionaccesslist. The documented
# legacy query (FunctionName/FunctionCode/Description/StatusCode WHERE
# AppID = FUNCTION_ACCESS_APP_ID) is tried first; columns are resolved
# tolerantly when it fails (see MssqlFunctionAccessRepository).
FUNCTION_ACCESS_VIEW=HMC_Sanad_AppMaster_VW
FUNCTION_ACCESS_APP_ID=1

# ── Cerner (appointments 41-44) ─────────────────────────────
CERNER_BASE_URL=https://cerner.example.hamad.qa
CERNER_TIMEOUT_MS=10000

# ── LDAP / Active Directory (auth framework: User Validate API-2 & Login API-5) ──
# Master switch; when false the app uses the dev bypass / stub adapter.
LDAP_ENABLED=false
LDAP_HOST=HMC.ORG.QA
LDAP_PORT=636
# true = LDAPS (SSL, port 636); false = plain LDAP (port 389)
LDAP_USE_SSL=true
# Optional explicit URL; leave empty to derive from host/port/ssl (e.g. ldaps://HMC.ORG.QA:636)
LDAP_URL=
# UPN suffix for direct binds (username@LDAP_UPN_DOMAIN) used by authenticate();
# leave empty to default to LDAP_HOST.
LDAP_UPN_DOMAIN=
LDAP_BASE_DN=DC=hmc,DC=org,DC=qa
# {username} is replaced with the sanitized login name at search time — used by validate() only
LDAP_SEARCH_FILTER=(sAMAccountName={username})
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
# Service/bind account used by validate()'s search (NOT needed for authenticate()'s direct bind)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# true in production (valid CA); false to accept self-signed certs in test.
# Set this true ONLY once LDAP_CA_CERT / LDAP_CA_CERT_PATH is configured below
# — otherwise every LDAPS bind fails with a self-signed-certificate TLS error.
LDAP_TLS_REJECT_UNAUTHORIZED=false
# CA certificate to trust for LDAPS (HMC's internal/self-signed AD CA).
# Option A — inline PEM, single line, real newlines escaped as \n:
# LDAP_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n
# Option B — a file path (mount the cert into the container if using Docker):
# LDAP_CA_CERT_PATH=/certs/hmc-ad-ca.pem
# Inline wins if both are set. Leave both empty only for a quick connectivity
# test with LDAP_TLS_REJECT_UNAUTHORIZED=false.
LDAP_CA_CERT=
LDAP_CA_CERT_PATH=
LDAP_TIMEOUT_MS=10000

# ── Diagnostics / logs / DB connection tests master switch ──
# true (default): /diagnostics/* (Oracle logs, oracle-object, users-db +
# motc-sms-db SQL consoles), /api-logs/* and the DB connection tests
# /health/db, /health/users-db, /health/motc-sms-db are available.
# false: those routes return 404 (indistinguishable from unknown routes).
# The plain /health liveness endpoint is NOT affected (the gateway needs it).
# Finer flags (USERS_DB_SQL_ENABLED, MOTC_SMS_SQL_ENABLED, DEV_CONSOLE_ENABLED)
# still apply on top when this is on.
DIAGNOSTICS_ENABLED=true

# ── Misc ────────────────────────────────────────────────────
# ── Internal developer console (SQL worksheet + API tester) ──────────────
# GET /api/v1/dev-console — SQL worksheet, Oracle object browser, PL/SQL source
# viewer (open a procedure at the ORA-06512 line), and an API tester that shows
# the Oracle calls each request produced. Hidden from Swagger.
#
# NOTHING BELOW IS REQUIRED — the console works out of the box and starts
# READ-ONLY (SELECT/WITH/EXPLAIN, rolled back). Write mode is a switch inside
# the page (per process, resets on restart), not an env variable.
# These are optional hardening only:
#   DEV_CONSOLE_ENABLED=false      # kill switch — routes return 404
#   DEV_CONSOLE_TOKEN=<secret>     # require `x-console-token` header / ?token=
#   DEV_CONSOLE_ALLOW_WRITE=true   # start already in write mode
#   DEV_CONSOLE_MAX_ROWS=500
#   DEV_CONSOLE_TIMEOUT_MS=60000

REQUEST_TIMEOUT_MS=30000
LOV_CACHE_TTL_MS=300000
LOG_LEVEL=debug

# --- Push notifications (Firebase Cloud Messaging) --------------------------
# The Firebase Admin service account: a PRIVATE KEY for the production project
# (sanaadprd). It goes in the server's `.env` — this file's real counterpart,
# next to docker-compose.yml, git-ignored, and the same place JWT_SECRET and
# USERS_DB_PASSWORD already live. Set once; it survives every deploy.
#
# ONE line, base64 of the key JSON, no quotes. Produce it with:
#   base64 -w0 sanaadprd-firebase-adminsdk-<id>.json
# The current key is 3156 characters. If the line wrapped, it will not parse.
#
# Then RECREATE the container - `docker restart` keeps the old environment:
#   docker compose up -d --force-recreate
# Check:  docker exec hmc-sanaad-backend printenv FIREBASE_SERVICE_ACCOUNT | wc -c   -> 3157
#         GET /api/v1/health -> push.status: "ok" (or "rejected" = arrived but unusable)
#
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/sanaad/firebase-service-account.json   # alternative: a mounted file
#
# Leaving both unset DISABLES sending — registrations are still accepted and
# stored, so tokens are already in place when the key arrives. Storage needs
# HMC_Sanad_DeviceToken_tbl (tools/notifications-schema.sql); until it exists
# registrations are discarded with a single warning and nothing else breaks.

# --- Device attestation (App Attest + Play Integrity) -----------------------
# Verifies a request came from a genuine build of the app. It sits next to
# authentication rather than replacing it: the JWT says WHO is calling, this
# says WHAT is.
#
#   off      (default) not checked at all
#   observe  verified and LOGGED, every request still allowed
#   enforce  an unverified request is rejected with 401
#
# ROLL OUT VIA `observe`. Enforcing rejects real devices — no Play Services,
# rooted, sideloaded, a simulator — so run observe for a release cycle and read
# how many requests would have been refused before switching. An unrecognised
# value also means off, so a typo cannot silently start rejecting users.
# APP_INTEGRITY_MODE=off

# iOS (Apple App Attest). NO Apple secret is needed: verification is local,
# against Apple's public root CA, so a Team ID and bundle id are the whole
# setup. (The .p8 keys people associate with this are for DeviceCheck and for
# APNs — neither is used here.) Both values are the Sanaad app's own identity,
# not confidential, and are already the defaults - nothing to set for iOS.
# APPLE_TEAM_ID=3E67ZH3EC8
# APPLE_BUNDLE_ID=com.hmc.sanaad
#
# Accept attestations from Xcode debug builds. Never set this in production —
# it is what tells a real device from a development one.
# APPLE_APP_ATTEST_ALLOW_DEVELOPMENT=false

# Android (Google Play Integrity). This is a SEPARATE credential from
# FIREBASE_SERVICE_ACCOUNT above: decoding an integrity token is its own Google
# API and needs a service account carrying the `playintegrity` scope. To create
# it: Google Cloud project 92441560390 -> enable "Play Integrity API" -> IAM ->
# Service Accounts -> new key (JSON) -> and link that project in Play Console.
# Same delivery as the Firebase key: one base64 line in the server's .env.
# (The project NUMBER goes in the mobile app's preparePlayIntegrityTokenProvider
# call, not here - the backend never reads it.)
# ANDROID_PACKAGE_NAME=com.hmc.sanaad
# PLAY_INTEGRITY_SERVICE_ACCOUNT=            # raw JSON or base64
# PLAY_INTEGRITY_SERVICE_ACCOUNT_PATH=       # or a path outside the repo

# How long an issued challenge stays usable (default 5 minutes).
# APP_INTEGRITY_CHALLENGE_TTL_MS=300000
#
# iOS storage needs HMC_Sanad_AttestChallenge_tbl and HMC_Sanad_AttestKey_tbl
# (tools/app-integrity-schema.sql). Android needs no tables. Until they exist,
# a warning is logged once and attestation simply cannot verify — nothing else
# breaks, and with the default mode nothing is checked anyway.
